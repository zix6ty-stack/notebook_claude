<Page
    x:Class="NoteTakingApp.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteTakingApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NoteTakingApp.ViewModels"
    xmlns:controls="using:NoteTakingApp.Controls"
    xmlns:converters="using:NoteTakingApp.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DateTimeOffsetToRelativeTimeConverter x:Key="DateTimeOffsetToRelativeTimeConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <vm:LibraryPageViewModel/>
    </Page.DataContext>

    <Grid>
        <!-- NavigationView Sidebar -->
        <NavigationView x:Name="NavView"
                        IsPaneOpen="True"
                        DisplayMode="Compact"
                        IsSettingsVisible="False"
                        PaneTitle="NoteTakingApp"
                        Header="All Notes"
                        BackRequested="NavView_BackRequested"
                        ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <!-- All Notes -->
                <NavigationViewItem Icon="AllApps" Content="All Notes" Tag="All"/>

                <!-- Favorites -->
                <NavigationViewItem Icon="Favorite" Content="Favorites" Tag="Favorites"/>

                <!-- Recent -->
                <NavigationViewItem Icon="Clock" Content="Recent" Tag="Recent"/>

                <!-- Separator -->
                <NavigationViewItemSeparator/>

                <!-- Folders (will be populated dynamically) -->
                <NavigationViewItem Icon="Folder" Content="Folders" Tag="FoldersSection">
                    <NavigationViewItem.MenuItems>
                        <!-- Folder items will be added here dynamically -->
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Trash -->
                <NavigationViewItem Icon="Delete" Content="Trash" Tag="Trash"/>
            </NavigationView.MenuItems>

            <!-- Search Box -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox QueryIcon="Find"
                                PlaceholderText="Search notebooks"
                                QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                TextChanged="AutoSuggestBox_TextChanged"/>
            </NavigationView.AutoSuggestBox>

            <!-- Content Area -->
            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                Padding="8"
                                Spacing="8">

                        <ToggleButton Content="Grid View"
                                      IsChecked="{Binding IsGridView, Mode=TwoWay}"
                                      Click="ViewToggleButton_Click"/>

                        <ToggleButton Content="List View"
                                      IsChecked="{Binding IsGridView, Mode=TwoWay}"
                                      Click="ViewToggleButton_Click"/>

                        <ComboBox Header="Sort by"
                                  Width="150"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SortOption, Mode=TwoWay}"
                                  SelectionChanged="SortComboBox_SelectionChanged"/>

                        <Button Content="+ New Notebook"
                                Click="NewNotebookButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- Content: Grid or List of notebook covers -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnWidth Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Grid View -->
                        <GridView Grid.Column="0"
                                  ItemsSource="{Binding Notebooks}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ItemClick="NotebookGridView_ItemClick"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="0"
                                                   ItemWidth="250"
                                                   ItemHeight="300"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:Notebook">
                                    <controls:NotebookCoverControl
                                        Width="250"
                                        Height="300"
                                        Notebook="{x:Bind}"/>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                            <GridView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename"
                                                    Click="RenameNotebookMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Duplicate"
                                                    Click="DuplicateNotebookMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Add to Favorites"
                                                    Click="AddToFavoritesMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Move to Folder"
                                                    Click="MoveToFolderMenuItem_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Delete"
                                                    Click="DeleteNotebookMenuItem_Click"/>
                                </MenuFlyout>
                            </GridView.ContextFlyout>
                        </GridView>

                        <!-- List View -->
                        <ListView Grid.Column="0"
                                  ItemsSource="{Binding Notebooks}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                                  ItemClick="NotebookListView_ItemClick"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Notebook">
                                    <Grid Height="60" Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnWidth Width="60"/>
                                            <ColumnWidth Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Notebook Cover Preview -->
                                        <Border Background="{x:Bind CoverColor}"
                                                CornerRadius="4"
                                                Width="48"
                                                Height="48">
                                            <TextBlock Text="{x:Bind Title}"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Notebook Info -->
                                        <StackGrid Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontWeight="SemiBold"
                                                       Style="{ThemeResource BodyTextBlockStyle}"/>
                                            <TextBlock Text="{x:Bind ModifiedDate, Converter={StaticResource DateTimeOffsetToRelativeTimeConverter}}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                        </StackGrid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename"
                                                    Click="RenameNotebookMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Duplicate"
                                                    Click="DuplicateNotebookMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Add to Favorites"
                                                    Click="AddToFavoritesMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Move to Folder"
                                                    Click="MoveToFolderMenuItem_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Delete"
                                                    Click="DeleteNotebookMenuItem_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Page>