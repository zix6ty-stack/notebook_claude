<Page
    x:Class="NoteTakingApp.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteTakingApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NoteTakingApp.ViewModels"
    xmlns:controls="using:NoteTakingApp.Controls"
    xmlns:converters="using:NoteTakingApp.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <vm:EditorPageViewModel/>
    </Page.DataContext>

    <Grid>
        <!-- Main Content: Split View with Page Sidebar and Editor Area -->
        <Grid.ColumnDefinitions>
            <ColumnWidth Width="Auto"/> <!-- Page Sidebar -->
            <ColumnWidth Width="*"/>    <!-- Editor Area -->
        </Grid.ColumnDefinitions>

        <!-- Page Sidebar (Thumbnails) -->
        <Grid Grid.Column="0"
              Width="80"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Padding="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <TextBlock Grid.Row="0"
                       Text="Pages"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>

            <!-- Page Thumbnails List -->
            <ListView Grid.Row="1"
                      ItemsSource="{Binding PageThumbnails}"
                      SelectedItem="{Binding SelectedPageThumbnail, Mode=TwoWay}"
                      ItemClick="PageThumbnailListView_ItemClick"
                      IsItemClickEnabled="True"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                        <Border Width="60"
                                Height="80"
                                Margin="0,4"
                                Background="{ThemeResource SystemControlBackgroundChromeLowBrush}"
                                CornerRadius="4">
                            <Grid>
                                <!-- Thumbnail Image -->
                                <Image Source="{x:Bind ThumbnailSource}"
                                       Stretch="UniformToFill"
                                       Width="60"
                                       Height="60"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"/>

                                <!-- Page Number -->
                                <TextBlock Text="{x:Bind PageNumber}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,2"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>

        <!-- Editor Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Toolbar -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Custom Floating Toolbar -->
            <Grid Grid.Row="0"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="Auto"/>
                    <ColumnWidth Width="*"/>
                    <ColumnWidth Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tool Selection Buttons -->
                <ToggleButton x:Name="PenButton"
                              Content="Pen"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Pen}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <ToggleButton x:Name="PencilButton"
                              Content="Pencil"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Pencil}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <ToggleButton x:Name="HighlighterButton"
                              Content="Highlighter"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Highlighter}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <ToggleButton x:Name="EraserButton"
                              Content="Eraser"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Eraser}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <ToggleButton x:Name="LassoButton"
                              Content="Lasso"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Lasso}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <ToggleButton x:Name="RulerButton"
                              Content="Ruler"
                              IsChecked="{Binding CurrentTool, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Ruler}"
                              Click="ToolButton_Click"
                              Margin="0,0,4,0"/>

                <!-- Tool Settings Flyouts -->
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ToolSettingsFlyout">
                        <StackPanel Width="200">
                            <!-- Thickness Slider -->
                            <TextBlock Text="Thickness"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <Slider Minimum="0.5"
                                    Maximum="10"
                                    Value="{Binding PenThickness, Mode=TwoWay}"
                                    Margin="0,0,0,8"/>

                            <!-- Color Picker -->
                            <TextBlock Text="Color"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ColorPicker Color="{Binding PenColor, Mode=TwoWay}"
                                         Margin="0,0,0,8"/>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>

                <!-- Spacer -->
                <Rectangle Grid.Column="6"
                           Width="4"
                           Fill="{ThemeResource SystemControlBackgroundTransparentBrush}"/>

                -- Page Operations -->
                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button Content="←"
                            ToolTipService.ToolTip="Previous Page"
                            Click="PreviousPageButton_Click"
                            Width="24"
                            Height="24"/>

                    <Button Content="→"
                            ToolTipService.ToolTip="Next Page"
                            Click="NextPageButton_Click"
                            Width="24"
                            Height="24"/>

                    <Button Content="+"
                            ToolTipService.ToolTip="New Page"
                            Click="NewPageButton_Click"
                            Width="24"
                            Height="24"/>

                    <Button Content="⋯"
                            ToolTipService.ToolTip="Page Options"
                            Click="PageOptionsButton_Click"
                            Width="24"
                            Height="24"/>
                </StackPanel>
            </Grid>

            <!-- Main Content: Scrollable Canvas with Zoom -->
            <Grid Grid.Row="1">
                <!-- ScrollViewer with Zoom Support -->
                <ScrollViewer x:Name="ContentScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="0.25"
                              MaxZoomFactor="5.0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ZoomChanged="ContentScrollViewer_ZoomChanged"
                              DoubleTapped="ContentScrollViewer_DoubleTapped">

                    <!-- Content Container -->
                    <Canvas x:Name="ContentCanvas"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

                        <!-- Ink Layer -->
                        <InkCanvas x:Name="MainInkCanvas"
                                   Width="{Binding PageWidth}"
                                   Height="{Binding PageHeight}"/>

                        <!-- Text Overlay Layer -->
                        <Canvas x:Name="TextOverlayCanvas"/>

                        <!-- Image Overlay Layer -->
                        <Canvas x:Name="ImageOverlayCanvas"/>

                        <!-- Selection Rectangle (for lasso) -->
                        <Rectangle x:Name="SelectionRectangle"
                                   Stroke="{ThemeResource SystemControlAccentAccent1Brush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="2,2"
                                   Fill="{ThemeResource SystemControlAccentAccent1Brush}"
                                   Opacity="0.2"
                                   Visibility="Collapsed"/>

                        <!-- Paper Template Background -->
                        <ItemsControl x:Name="PaperTemplateItemsControl"
                                      ItemsSource="{Binding PaperTemplateLines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}"
                                          Y1="{Binding Y1}"
                                          X2="{Binding X2}"
                                          Y2="{Binding Y2}"
                                          Stroke="{Binding StrokeColor}"
                                          StrokeThickness="{Binding StrokeWidth}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </ScrollViewer>

                -- Zoom Controls (touch-friendly) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Spacing="8">
                    <Button Content="−"
                            Width="32"
                            Height="32"
                            Click="ZoomOutButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>

                    <TextBlock Text="{Binding ZoomFactor, Converter={StaticResource DoubleToPercentageConverter}}"
                               Width="60"
                               TextAlign="Center"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyTextBlockStyle}"/>

                    <Button Content="+"
                            Width="32"
                            Height="32"
                            Click="ZoomInButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>