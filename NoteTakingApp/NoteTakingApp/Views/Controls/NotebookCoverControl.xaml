<UserControl
    x:Class="NoteTakingApp.Controls.NotebookCoverControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteTakingApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NoteTakingApp.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="250">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Notebook Cover with Thumbnail -->
        <Border Grid.Row="0"
                Background="{x:Bind Notebook.CoverColor, Mode=OneWay}"
                CornerRadius="8"
                Width="250"
                Height="250">
            <Grid>
                <!-- Thumbnail Placeholder -->
                <!-- In a real app, this would show the first page thumbnail -->
                <Border x:Name="ThumbnailPlaceholder"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                        Width="200"
                        Height="160"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Notebook.Title, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="180"/>
                </Border>

                <!-- Favorite Indicator -->
                <Border x:Name="FavoriteIndicator"
                        Background="{ThemeResource SystemControlAccentAccent1Brush}"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Visibility="{x:Bind Notebook.IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <SymbolIcon Symbol="Favorite"
                                Foreground="White"
                                Width="12"
                                Height="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Notebook Title -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind Notebook.Title, Mode=OneWay}"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   MaxWidth="250"
                   TextTrimming="WordEllipsis"/>
    </Grid>
</UserControl>