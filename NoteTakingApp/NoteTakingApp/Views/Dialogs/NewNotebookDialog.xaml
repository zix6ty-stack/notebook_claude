<ContentDialog
    x:Class="NoteTakingApp.Views.Dialogs.NewNotebookDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteTakingApp.Views.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NoteTakingApp.ViewModels"
    Title="New Notebook"
    PrimaryButtonText="Create"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <ContentDialog.DataContext>
        <vm:NewNotebookDialogViewModel/>
    </ContentDialog.DataContext>

    <StackPanel Spacing="12">
        <TextBox Header="Notebook Title"
                 PlaceholderText="Enter notebook title"
                 Text="{Binding Title, Mode=TwoWay}"
                 Width="300"/>

        <TextBlock Text="Cover Color"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0,4,0,0"/>

        <ColorPicker Color="{Binding CoverColor, Mode=TwoWay}"
                     Width="300"/>

        <ComboBox Header="Folder"
                  PlaceholderText="Select folder (optional)"
                  ItemsSource="{Binding AvailableFolders}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedFolderId, Mode=TwoWay}"
                  Width="300"/>

        <TextBlock Text="Paper Template"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0,4,0,0"/>

        <ComboBox Header="Paper Template"
                  PlaceholderText="Select paper template"
                  ItemsSource="{Binding PaperTemplates}"
                  SelectedItem="{Binding PaperTemplate, Mode=TwoWay}"
                  Width="300"/>

        <TextBlock Text="Page Size"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0,4,0,0"/>

        <ComboBox Header="Page Size"
                  PlaceholderText="Select page size"
                  ItemsSource="{Binding PageSizes}"
                  SelectedItem="{Binding PageSize, Mode=TwoWay}"
                  Width="300"/>
    </StackPanel>
</ContentDialog>